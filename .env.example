# ---- HTTP ----
PORT=8095

# ---- MySQL (device registry) ----
DB_HOST=127.0.0.1
DB_USER=
DB_PASS=
DB_NAME=asterisk

# ---- Apple APNs (iOS VoIP push) ----
# Create a VoIP Services certificate (.p8). Do NOT use a universal .p8.
APNS_ENABLED=false
APNS_KEY_FILE=/etc/sokrat/apns/AuthKey.p8
APNS_KEY_ID=ABCDEF1234
APNS_TEAM_ID=TEAMID12345
APNS_TOPIC=com.sokrat.voice.voip
# production | development
APNS_ENV=production

# ---- Firebase Cloud Messaging (Android) ----
# Download firebase-adminsdk service account json from Firebase console.
# Enabled by default. If no credentials are found the gateway logs a warning and
# keeps running without FCM (calls still work, only wake pushes are skipped).
FCM_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/etc/sokrat/firebase/service-account.json

# ---- Public single-PBX media gateway (optional) ----
# Generated on the gateway; never commit the real value.
TURN_SHARED_SECRET=
TURN_PUBLIC_HOST=
# Private PBX API used only for extension credential verification.
PBX_AUTH_URL=

# Optional private control plane + approved-device runtime.
# CONTROL_ADMIN_PASSWORD_HASH must be generated; no built-in admin password.
CONTROL_DATA_FILE=
CONTROL_ADMIN_PASSWORD_HASH=
CONTROL_MAX_ENABLED_PBX=5
CONTROL_MAX_EXTENSIONS=5000
CONTROL_CLAIM_TTL_MINUTES=1440
CONTROL_ENROLL_PRIVATE_ONLY=false
TENANT_RUNTIME_FILE=
TENANT_PUSH_FILE=
